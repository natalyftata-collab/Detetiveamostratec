         print("Voce continua no mesmo lugar.")
      senao
         se jaSaiu = falso entao
            se decisao = 1 entao
               print("Voce ainda esta no salao principal.")
               decisao <- 0
            senao
               jaSaiu   <- verdadeiro
               atual    <- decisao
               descrito <- falso
            fimse
         senao
            se acessoMasmorra = falso entao
               se (decisao >= 1) e (decisao <= 5) entao
                  atual    <- decisao
                  descrito <- falso
               fimse
