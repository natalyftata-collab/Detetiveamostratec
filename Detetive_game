      escreva("Decisao: ")
      leia(decisao)
      limpatela

      se decisao = atual entao
         print("Voce continua na mesma sala.")
      senao
         se jaSaiu = falso entao
            se decisao = 1 entao
               print("Voce nao saiu do lugar, detetive.")
               decisao <- 0
            senao
               jaSaiu   <- verdadeiro
               atual    <- decisao
               descrito <- falso
            fimse
         senao
            se (decisao >= 1) e (decisao <= 5) entao
               atual    <- decisao
               descrito <- falso
            fimse
         fimse
      fimse

   ate (decisao >= 1) e (decisao <= 5)
fimprocedimento

